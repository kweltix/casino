# Сервер и worker читают .env.local. Настоящие ключи не добавляйте в Git.
DATABASE_PATH=data/agent.sqlite
AI_PROVIDER_API_KEY=
AI_TEXT_MODEL=gpt-5-mini
AI_IMAGE_MODEL=gpt-image-2.5-flare
# Поиск по публичным каталогам выполняется инструментом OpenAI web_search.
# Обязательный пароль владельца, минимум 16 символов. Генерация: npm run auth:setup
APP_PASSWORD=
# Для публичного сервера: точный HTTPS origin. Render передаёт RENDER_EXTERNAL_URL автоматически.
# APP_ORIGIN=https://your-service.onrender.com
